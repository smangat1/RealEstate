SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
OPENROUTESERVICE_API_KEY=
HOMEBOARD_OPERATOR_EMAILS=
HOMEBOARD_ADMIN_EMAILS=
HOMEBOARD_NOINDEX=true
ENABLE_APP=true
DEMO_MODE=false
# Canonical sharing host. Keep this in sync with the iOS Associated Domains entitlement.
NEXT_PUBLIC_SITE_URL=https://real-estate-samyanmangat-6662s-projects.vercel.app

# Optional legacy web-assistant settings. The native beta does not require Ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EXTRACT_MODEL=llama3.2:3b
OLLAMA_REPLY_MODEL=llama3.2:3b

# Optional future source. Homeboard never scrapes or fabricates live listings.
LISTING_PROVIDER_NAME=
LISTING_PROVIDER_BASE_URL=
LISTING_PROVIDER_API_KEY=

# Server-only. Never expose this value through NEXT_PUBLIC_* or the iOS app.
RENTCAST_API_KEY=

# Optional exact-source resolver. Server-only and permanently cached.
BRAVE_SEARCH_API_KEY=
# Optional public support inbox. Leave unset until the address is monitored.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Official App Store or TestFlight URL used when an invite recipient needs to install Homeboard.
NEXT_PUBLIC_IOS_INSTALL_URL=
# Official Mac App Store, TestFlight, or signed beta download for Homeboard Safari Setup.
NEXT_PUBLIC_MAC_INSTALL_URL=

# Error monitoring. The public DSN is safe for browser builds; keep the auth token server-only.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional vendor-neutral alert sink for critical server and native diagnostic events.
HOMEBOARD_ALERT_WEBHOOK_URL=
HOMEBOARD_ALERT_WEBHOOK_BEARER_TOKEN=

# Apple Push Notification service token credentials. Server-only.
APNS_KEY_ID=
APNS_TEAM_ID=4SSAVHCM6U
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.homeboard.native
