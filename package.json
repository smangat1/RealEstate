{
  "name": "realestate",
  "version": "0.0.13",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "prisma generate",
    "build": "next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit --pretty false && tsc --project tsconfig.tests.json --pretty false",
    "secrets:check": "tsx scripts/check-tracked-secrets.ts",
    "env:check": "tsx scripts/check-env-contract.ts",
    "security:check": "npm run secrets:check && npm run env:check && npm audit --audit-level=high",
    "prisma:validate": "prisma validate",
    "verify": "npm run secrets:check && npm run env:check && npm run lint && npm run test && npm run typecheck && npm run build",
    "ios:generate": "cd ios/HomeboardNative && xcodegen generate --spec project.yml",
    "ios:test": "xcodebuild -quiet -project ios/HomeboardNative/HomeboardNative.xcodeproj -scheme HomeboardNative -destination 'platform=iOS Simulator,name=iPhone 17,OS=26.5' test",
    "ios:release": "xcodebuild -quiet -project ios/HomeboardNative/HomeboardNative.xcodeproj -scheme HomeboardNative -configuration Release -destination 'generic/platform=iOS Simulator' build CODE_SIGNING_ALLOWED=NO",
    "verify:all": "npm run verify && npm run prisma:validate && npm run ios:test && npm run ios:release",
    "lint": "eslint --no-warn-ignored app components lib scripts tests *.ts",
    "rentcast:status": "tsx scripts/check-rentcast-setup.ts",
    "rentcast:import": "tsx scripts/import-rentcast-listings.ts",
    "rentcast:refresh:nyc": "tsx scripts/import-rentcast-listings.ts --controlled-nyc-refresh --confirm-one-request"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "A shared rental-search workspace for roommate groups.",
  "overrides": {
    "browserslist": "4.28.9",
    "deepmerge-ts": "8.0.2",
    "postcss": "8.5.26"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@sentry/nextjs": "^10.73.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.4.2",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^26.1.0",
    "prisma": "^6.16.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
