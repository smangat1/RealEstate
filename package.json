{
  "name": "realestate",
  "version": "0.0.13",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "prisma generate",
    "build": "next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "prisma:validate": "prisma validate",
    "verify": "npm run test && npm run typecheck && npm run build",
    "ios:generate": "cd ios/HomeboardNative && xcodegen generate --spec project.yml",
    "ios:test": "xcodebuild -quiet -project ios/HomeboardNative/HomeboardNative.xcodeproj -scheme HomeboardNative -destination 'platform=iOS Simulator,name=iPhone 17,OS=26.5' test",
    "ios:release": "xcodebuild -quiet -project ios/HomeboardNative/HomeboardNative.xcodeproj -scheme HomeboardNative -configuration Release -destination 'generic/platform=iOS Simulator' build CODE_SIGNING_ALLOWED=NO",
    "verify:all": "npm run verify && npm run prisma:validate && npm run ios:test && npm run ios:release",
    "lint": "next lint",
    "db:seed": "tsx scripts/generate-dummy-data.ts --scale demo --reset",
    "db:seed:large": "tsx scripts/generate-dummy-data.ts --scale large --reset",
    "db:seed:huge": "tsx scripts/generate-dummy-data.ts --scale huge --reset",
    "rentcast:status": "tsx scripts/check-rentcast-setup.ts",
    "rentcast:import": "tsx scripts/import-rentcast-listings.ts",
    "rentcast:refresh:nyc": "tsx scripts/import-rentcast-listings.ts --controlled-nyc-refresh --confirm-one-request"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "A shared rental-search workspace for roommate groups.",
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "next": "^16.2.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "prisma": "^6.16.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
